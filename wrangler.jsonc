{
  // Static-assets Worker: serves the Vite build. SPA fallback sends every
  // unknown path to index.html so /doc/<id> survives a reload.
  "name": "sop-builder",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
