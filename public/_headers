# The app shell must always be revalidated so a new deploy is picked up on the
# next load; hashed assets never change, so they can be cached forever.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/doc/*
  Cache-Control: no-cache
/templates
  Cache-Control: no-cache
/templates/*
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
